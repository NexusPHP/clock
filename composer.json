{
    "name": "nexusphp/clock",
    "description": "Nexus Clock decouples applications from calendar time, monotonic time, and waiting for better testing.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "nexus",
        "clock",
        "psr-20",
        "stopwatch",
        "monotonic",
        "delay"
    ],
    "authors": [
        {
            "name": "John Paul E. Balandan, CPA",
            "email": "paulbalandan@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/NexusPHP/clock/issues",
        "source": "https://github.com/NexusPHP/clock.git"
    },
    "require": {
        "php": "^8.3",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.34 || ^0.35",
        "nexusphp/cs-config": "^3.29",
        "nexusphp/tachycardia": "^2.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5 || ^13.3"
    },
    "provide": {
        "psr/clock-implementation": "1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nexus\\Clock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Clock\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "cs:check": "php-cs-fixer check --ansi --verbose --diff",
        "cs:fix": "php-cs-fixer fix --ansi --verbose --diff",
        "mutation:check": "infection --with-uncovered --static-analysis-tool=phpstan",
        "phpstan:baseline": "phpstan analyse --ansi --verbose --generate-baseline=phpstan-baseline.php",
        "phpstan:check": "phpstan analyse --ansi --verbose",
        "test:all": [
            "@cs:check",
            "@phpstan:check",
            "@test:unit",
            "@mutation:check"
        ],
        "test:unit": "phpunit --colors=always --coverage-html=build/phpunit/html --coverage-clover=build/phpunit/clover.xml"
    },
    "scripts-descriptions": {
        "cs:check": "Checks for coding style violations",
        "cs:fix": "Fixes any coding style violations",
        "mutation:check": "Runs the mutation testing suite",
        "phpstan:baseline": "Runs PHPStan and dumps resulting errors to baseline",
        "phpstan:check": "Runs PHPStan with identifiers support",
        "test:all": "Runs all tests",
        "test:unit": "Runs all PHPUnit tests"
    }
}
